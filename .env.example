APP_NAME=AlertBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alertbook
DB_USERNAME=alertbook
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Le code applicatif écrit explicitement sur Storage::disk('public').
# Gardez local pour un serveur unique Forge, ou utilisez s3 pour DigitalOcean Spaces.
PUBLIC_FILESYSTEM_DRIVER=local
PUBLIC_FILESYSTEM_PREFIX=

LIVEWIRE_UPLOAD_DISK=local
LIVEWIRE_UPLOAD_DIRECTORY=livewire-tmp
LIVEWIRE_UPLOAD_RULES="file|mimes:png,jpg,jpeg,pdf,doc,docx|max:10240"

# Emails: Resend recommandé pour éviter les blocages SMTP sortants.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="${APP_NAME}"

# S3 / DigitalOcean Spaces.
# Exemple Spaces:
# AWS_DEFAULT_REGION=nyc3
# AWS_BUCKET=alertbook-production
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_URL=https://alertbook-production.nyc3.digitaloceanspaces.com
# AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documentation vidéo: local ou S3/Spaces.
ALERTBOOK_DOCUMENTATION_DRIVER=local
ALERTBOOK_DOCUMENTATION_PATH=
ALERTBOOK_DOCUMENTATION_DISK=s3
ALERTBOOK_DOCUMENTATION_BUCKET=
ALERTBOOK_DOCUMENTATION_ENDPOINT=
ALERTBOOK_DOCUMENTATION_PREFIX=documentation/videos
ALERTBOOK_DOCUMENTATION_URL_TTL=3600

# Scheduler Forge: incidents:notify-sla est planifié via routes/console.php.
ALERTBOOK_SLA_NOTIFICATION_TIME=08:00

VITE_APP_NAME="${APP_NAME}"
