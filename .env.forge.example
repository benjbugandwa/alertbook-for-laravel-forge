APP_NAME=AlertBook
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://apps.alertbook.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alertbook
DB_USERNAME=forge
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.alertbook.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Option A - stockage local sur le droplet Forge.
# Nécessite php artisan storage:link, inclus dans forge/deploy.sh.
PUBLIC_FILESYSTEM_DRIVER=local
PUBLIC_FILESYSTEM_PREFIX=

# Option B - DigitalOcean Spaces pour les fichiers utilisateurs.
# Décommentez ces lignes et remplissez-les si vous voulez sortir les uploads du disque local.
# PUBLIC_FILESYSTEM_DRIVER=s3
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_DEFAULT_REGION=nyc3
# AWS_BUCKET=alertbook-production
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_URL=https://alertbook-production.nyc3.digitaloceanspaces.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

LIVEWIRE_UPLOAD_DISK=local
LIVEWIRE_UPLOAD_DIRECTORY=livewire-tmp
LIVEWIRE_UPLOAD_RULES="file|mimes:png,jpg,jpeg,pdf,doc,docx|max:10240"

# Emails - recommandé: Resend, déjà supporté par composer.json.
MAIL_MAILER=resend
RESEND_API_KEY=CHANGE_ME
MAIL_FROM_ADDRESS=notifications@alertbook.org
MAIL_FROM_NAME="AlertBook"

# Documentation vidéo.
# Local: téléverser les vidéos dans un dossier persistant du serveur.
ALERTBOOK_DOCUMENTATION_DRIVER=local
ALERTBOOK_DOCUMENTATION_PATH=/home/forge/apps.alertbook.org/shared/documentation

# S3/Spaces: recommandé si les vidéos sont volumineuses.
# ALERTBOOK_DOCUMENTATION_DRIVER=s3
ALERTBOOK_DOCUMENTATION_DISK=s3
ALERTBOOK_DOCUMENTATION_BUCKET=
ALERTBOOK_DOCUMENTATION_ENDPOINT=
ALERTBOOK_DOCUMENTATION_PREFIX=documentation/videos
ALERTBOOK_DOCUMENTATION_URL_TTL=3600

ALERTBOOK_SLA_NOTIFICATION_TIME=08:00

VITE_APP_NAME="${APP_NAME}"
